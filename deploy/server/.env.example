# 复制成 .env 后修改（bootstrap.sh 会自动读取同目录的 .env）
# 注意：这些 key 只发给**你自己的**服务器，用来防止端口被误用。

# 服务器上放东西的根目录
CITTY_ROOT=/opt/citty-server

# 两个服务只监听 127.0.0.1，靠 SSH 隧道访问
CITTY_ASR_PORT=8001
CITTY_MT_PORT=8002

# 翻译模型（GGUF）。默认 1.8B Q6_K ≈ 1.37GB；
# 显存富余可换 tencent/Hy-MT2-7B-GGUF + HY-MT2-7B-Q4_K_M.gguf（≈4.31GB）
CITTY_MT_REPO=tencent/Hy-MT2-1.8B-GGUF
CITTY_MT_FILE=Hy-MT2-1.8B-Q6_K.gguf
CITTY_MT_CTX=4096

# 国内下 HF 慢的话用镜像（第三方，自行判断）；ModelScope 源见 bootstrap.sh 注释
HF_ENDPOINT=https://hf-mirror.com

# 两个自定 key，本地 config.remote.yaml 里要填一样的
CITTY_MT_KEY=change-me-mt-key
CITTY_ASR_KEY=change-me-asr-key
