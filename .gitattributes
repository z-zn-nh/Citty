# 统一换行符：仓库内存 LF，检出时按平台（避免"整个文件都改了"的假 diff）
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf

# 二进制：明确声明，别让 git 去猜
*.png  binary
*.jpg  binary
*.wav  binary
*.mp3  binary
*.onnx binary
*.srt  text eol=lf
*.csv  text eol=lf
